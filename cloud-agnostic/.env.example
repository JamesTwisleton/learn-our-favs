# Copy to .env for local development. Never commit .env.
# Provider selection (ADR 0009): 'local' uses the docker-compose stack.
CLOUD_PROVIDER=local            # local | aws | gcp

# --- Relational (Postgres / RDS / Spanner PG) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/lmf
DATABASE_USER=lmf
DATABASE_PASSWORD=lmf

# --- Document store (band notes) ---
MONGODB_URI=mongodb://localhost:27017/lmf_notes

# --- Cache ---
REDIS_URL=redis://localhost:6379

# --- Events ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=local           # branch name in PR previews (PRD §9)

# --- Search ---
OPENSEARCH_URL=http://localhost:9200

# --- Object storage (S3 / GCS / MinIO) ---
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=lmf-media
OBJECT_STORE_ACCESS_KEY=lmf
OBJECT_STORE_SECRET_KEY=lmf-secret

# --- Identity (Cognito / GCP Identity Platform; stub locally) ---
IDP_ISSUER_URL=http://localhost:9099
SESSION_TOKEN_SIGNING_KEY=dev-only-change-me

# --- Spotify (prototype scopes, docs/SALVAGE.md) ---
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_SCOPES=user-read-email user-top-read playlist-modify-public playlist-modify-private

# --- YouTube (link-paste only, videos.list = 1 unit; ADR 0010) ---
YOUTUBE_API_KEY=your-youtube-data-api-key
