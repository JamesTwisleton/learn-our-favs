# Copy to .env.local. Values below are the defaults printed by `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from `supabase start`>

# Server-only. Never exposed to the browser. Used to read/write private.* tables
# (Spotify refresh tokens) and to run the pool functions.
SUPABASE_SERVICE_ROLE_KEY=<service_role key from `supabase start`>

# Spotify app credentials (https://developer.spotify.com/dashboard).
# Redirect URI to register: http://127.0.0.1:3000/auth/spotify/callback
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Public site URL, used to build OAuth redirect URIs.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
